# User-supplied APKs: analysis only, never redistribute in Git.
/google_drive/
# Separate native Android / WebXR application
/discord-vr-g2/node_modules/
/discord-vr-g2/build/
/discord-vr-g2/.env
/discord-vr-g2/.env.*
!/discord-vr-g2/.env.example
*.idsig
# Requested, small original compiled deliverable (no vendor runtime bundled).
!/discord-vr-g2/web/downloads/Discord-VR-G2.apk
/discord-vr-g2/web/downloads/*.zip
# Original rhythm game: keep source assets and requested signed APK, not caches.
/pulse-saber-g2/node_modules/
/pulse-saber-g2/build/
/pulse-saber-g2/web/downloads/*.zip
!/pulse-saber-g2/web/downloads/Pulse-Saber-G2.apk

# MonkeGo: source assets tracked; CI output and dependencies excluded.
/monke-go/node_modules/
/monke-go/build/
/monke-go/dist/
/monke-go/downloads/

# Separate supplied Gorilla Rush v45 edition; preserve the previous MonkeGo.
/gorilla-rush-v45/node_modules/
/gorilla-rush-v45/build/
/gorilla-rush-v45/downloads/

